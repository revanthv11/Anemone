# Copy to .env (git ignores it) and fill it in. docker compose and the scripts next to it read it;
# a variable already set in the environment wins.

# The administrator the startup wizard creates. Hidden from the sign-in screen afterwards.
ADMIN_USER=admin
ADMIN_PASSWORD=

# The account App Review signs in with. Leave the password empty and setup.sh makes one up and
# writes it here.
REVIEWER_USER=reviewer
REVIEWER_PASSWORD=

# What the server calls itself on the add-server screen.
SERVER_NAME=Anemone review

# Where setup.sh and check.sh reach the server. Change it to the public https address once
# Caddy or a tunnel is in front, so check.sh tests what the reviewer will type.
JELLYFIN_URL=http://localhost:8096

# For `docker compose --profile https`: the DNS name Caddy gets a certificate for. Point it at
# this machine first, and open ports 80 and 443. Then set REVIEW_SERVER_BIND to 127.0.0.1 so
# plain http://…:8096 isn't reachable from outside too.
REVIEW_SERVER_HOST=
REVIEW_SERVER_BIND=0.0.0.0

# The host port for plain HTTP, if 8096 is taken.
REVIEW_SERVER_PORT=8096
