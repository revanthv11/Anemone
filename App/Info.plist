<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Keychain access group shared with the Top Shelf, with the team prefix filled in. -->
	<key>AnemoneKeychainAccessGroup</key>
	<string>$(AppIdentifierPrefix)com.revanthv11.anemone.shared</string>
	<!-- anemone:// links from the Top Shelf and elsewhere (App/DeepLinks). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.revanthv11.anemone</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>anemone</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Home Jellyfin servers are usually reached over plain HTTP at an address the user types,
		     so no list of domains can name them. The case for App Review is in docs/release/ats.md. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- HTTPS through the system only, which is exempt; see docs/release/export-compliance.md. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Anemone connects to the Jellyfin servers you add, including ones on your home network.</string>
</dict>
</plist>
